# ============================================================
#  MentalOS — пример переменных окружения
# ============================================================
#  Этот файл — ШАБЛОН. Реальные значения вписывай в файл .env
#  (он не попадает в GitHub — см. .gitignore).
#
#  БОТ ТОКЕН НИКОГДА не вписывай сюда и не коммить в GitHub!
# ============================================================

# Токен твоего бота из @BotFather.
# Получить: @BotFather → /mybots → MentalOS → API Token
BOT_TOKEN=

# URL подключения к PostgreSQL.
# Локально: postgres://user:password@localhost:5432/mentalos
# На Render: скопируй External Database URL из дашборда Render Postgres
DATABASE_URL=

# URL фронтенда (Telegram WebApp).
# Локально: http://localhost:5173
# На Render: https://твой-сервис.onrender.com
WEBAPP_URL=

# Порт для бэкенда (Render задаёт автоматически через PORT)
PORT=3001
